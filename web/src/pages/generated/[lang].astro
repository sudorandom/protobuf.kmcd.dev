---
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import Layout from "../../layouts/Layout.astro";
import { SyntaxHighlighter } from "../../components/shared/Common";

// Read the real generated files at build time so this page can never drift
// from what `buf generate` actually produces for the demo schema.
const here = path.dirname(fileURLToPath(import.meta.url));
const repoRoot = path.resolve(here, "../../../..");

const FILES = [
  {
    lang: "typescript",
    repoPath: "web/src/gen/demo/v1/user_pb.ts",
    name: "user_pb.ts",
    plugin: "protoc-gen-es",
    desc: "TypeScript interface, classes, and binary/JSON codec metadata.",
  },
  {
    lang: "go",
    repoPath: "gen/go/demo/v1/user.pb.go",
    name: "user.pb.go",
    plugin: "protoc-gen-go",
    desc: "Go structs, field getters, ProtoReflect, and binary marshal/unmarshal.",
  },
] as const;

export function getStaticPaths() {
  return [{ params: { lang: "typescript" } }, { params: { lang: "go" } }];
}

const { lang } = Astro.params;
const file = FILES.find((f) => f.lang === lang)!;
const code = fs.readFileSync(path.join(repoRoot, file.repoPath), "utf8");
const lineCount = code.trimEnd().split("\n").length;
---

<Layout
  title={`${file.name} | Protobuf Explained`}
  description={`The ${file.name} file generated from the demo Protobuf schema by ${file.plugin}.`}
>
  <section class="py-16 px-4 sm:px-8">
    <div class="max-w-5xl mx-auto space-y-8">
      <div class="space-y-4">
        <a
          href="/basics/#generating-code"
          class="text-xs font-mono uppercase tracking-widest text-[var(--cyber-neon-blue)] hover:underline"
        >
          &larr; Back to Generating Code
        </a>
        <h1
          class="text-2xl sm:text-4xl font-cyber font-black uppercase tracking-tight text-[var(--text-color)] break-all"
        >
          {file.name}
        </h1>
        <p class="text-[var(--text-dim)] leading-relaxed max-w-3xl">
          {file.desc}
        </p>
        <p class="text-sm text-[var(--text-dim)] leading-relaxed max-w-3xl">
          Generated from <code>proto/demo/v1/user.proto</code> by <code
            >{file.plugin}</code
          >, and used by the interactive demos on this site. Generated code is
          committed and never hand-edited &mdash; rerunning <code
            >buf generate</code
          > reproduces it exactly.
        </p>
        <div
          class="flex flex-wrap gap-x-6 gap-y-1 text-xs font-mono text-[var(--text-dim)] uppercase tracking-widest"
        >
          <span>{file.repoPath}</span>
          <span>{lineCount} lines</span>
        </div>
      </div>

      <div
        class="border border-[var(--border-light)] rounded-lg bg-[var(--panel-bg)] overflow-hidden"
      >
        <div
          class="px-4 py-2 border-b border-[var(--border-light)] bg-[var(--overlay-bg)] text-xs font-mono uppercase tracking-widest text-[var(--text-dim)]"
        >
          {file.name}
        </div>
        <div class="p-4 overflow-x-auto">
          <SyntaxHighlighter
            language={file.lang === "typescript" ? "typescript" : "go"}
            code={code}
          />
        </div>
      </div>
    </div>
  </section>
</Layout>
