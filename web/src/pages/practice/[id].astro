---
import Layout from "../../layouts/Layout.astro";
import { Practice } from "../../react-pages/Practice";
import { EXERCISES } from "../../data/practice-data";

export function getStaticPaths() {
  return [
    ...EXERCISES.map((exercise) => ({ params: { id: String(exercise.id) } })),
    { params: { id: "conclusion" } },
  ];
}

const { id } = Astro.params;

const titleMap: Record<string, string> = {
  ...Object.fromEntries(
    EXERCISES.map((exercise) => [
      String(exercise.id),
      `Exercise ${exercise.id}: ${exercise.title}`,
    ]),
  ),
  conclusion: "Practice Complete",
};

const pageTitle = titleMap[id] || `Exercise ${id}`;
---

<Layout
  title={`${pageTitle} | Protobuf Explained`}
  description="Practice Protocol Buffers by repairing schemas and satisfying descriptor checks."
>
  <Practice activeId={id} client:load />
</Layout>
